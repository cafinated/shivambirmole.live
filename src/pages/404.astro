---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <header class="page-head">
    <h1>This page is not on the sheet.</h1>
    <p class="lede">The address may be wrong, or the page may have moved.</p>
    <p style="margin-top: var(--space-5)"><a class="go" href="/work/">Go to the work <Arrow /></a></p>
  </header>
</Base>
