---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const products = work.filter((w) => w.data.kind === 'product');
const experience = work.filter((w) => w.data.kind === 'experience');
---

<Base
  title="Work"
  description="Products Shivam Birmole has built, and the operating and data work underneath them. Each entry states its stage."
>
  <header class="page-head">
    <h1>Everything here, with its stage stated.</h1>
    <p class="lede">Three products I built, then the operating and data work that came before them.</p>
    <ul class="jump" aria-label="On this page">
      <li><a href="#products">Products</a></li>
      <li><a href="#experience">Experience</a></li>
      <li><a href="/education/">Education</a></li>
      <li><a href="/future/">Build together</a></li>
    </ul>
  </header>

  <section class="section" id="products" aria-labelledby="products-title">
    <h2 id="products-title">Products</h2>
    <ul class="index">
      {
        products.map((w) => (
          <li>
            <a href={`/work/${w.id}/`}>
              <span class="index__years">{w.data.years}</span>
              <span class="index__title">{w.data.title}</span>
              <span class="index__lede">{w.data.lede}</span>
              <span class="index__stage">{w.data.stage}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="experience" aria-labelledby="experience-title">
    <h2 id="experience-title">Operating and data work</h2>
    <ul class="index">
      {
        experience.map((w) => (
          <li>
            <a href={`/work/${w.id}/`}>
              <span class="index__years">{w.data.years}</span>
              <span class="index__title">{w.data.title}</span>
              <span class="index__lede">{w.data.lede}</span>
              <span class="index__stage">{w.data.stage}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="archive-title">
    <h2 id="archive-title">From the archive</h2>
    <p class="archive">
      July 2021: an online table-reservation website with login and signup, dynamic menus and reservation management,
      written in PHP, HTML, CSS and JavaScript. A college-era build, and the first time I shipped something with a
      login.
    </p>
  </section>
</Base>
