---
// "Walk my journey": a small side-scrolling game. Shivam walks one path through the places of his life,
// growing up (and growing a beard) as he goes. Black and white line art, drawn in SVG.
// Controls: hold → / ← (or A / D), hold the on-screen arrows, tap a stop on the map, or "Walk for me".
// Reduced motion: no walk cycle; the map jumps between stops.
import Base from '../layouts/Base.astro';

const STEP = 1150;
const FIRST = 700;
const stops = [
  { key: 'school', when: 'Up to Class X', title: 'Kankavli', text: 'Where I grew up and went to school.' },
  { key: 'mumbai', when: 'Class XI and XII', title: 'Mumbai', text: 'Off to the big city for junior college.' },
  { key: 'cafe', when: '2018', title: 'Café 101, back in Kankavli', text: 'After Class XII I opened a small café with my own money. Maggizza was on the menu.' },
  { key: 'college', when: '2018 to 2022', title: 'Engineering, NMIMS Mumbai', text: 'A B.Tech, hackathons, and chairing the NM Debate Society.' },
  { key: 'pune', when: '2022 to 2026', title: 'TresVista, Pune', text: 'Four years building data pipelines and dashboards. Evenings at concerts and the gym.' },
  { key: 'travel', when: 'Whenever I can', title: '15+ countries', text: 'Mostly solo, usually with a camera. Summits, seas, and roads through the hills.' },
  { key: 'hospital', when: 'The gap', title: 'The family hospital, Kankavli', text: 'Back home before Masters\' Union, working on how the hospital runs.' },
  { key: 'mu', when: '2026 on', title: "Masters' Union", text: 'Post Graduate Programme in Technology & Business Management.' },
  { key: 'build', when: 'Now', title: 'Building things', text: 'MedDraft, Kuchu Puchu and MU Central. The path keeps going.' },
].map((s, i) => ({ ...s, x: FIRST + i * STEP }));
const WORLD = FIRST + (stops.length - 1) * STEP + 900;
const G = 430;
---

<Base
  title="Walk my journey"
  description="A small game: walk with Shivam Birmole from school in Kankavli to Mumbai, a café, engineering, Pune, travel, the family hospital and Masters' Union."
>
  <section class="journey" data-journey aria-labelledby="journey-title">
    <header class="journey__head">
      <h1 id="journey-title">Walk my journey</h1>
      <p class="journey__how pen" data-how>
        <span class="only-keys">Hold → to walk, ← to go back.</span>
        <span class="only-touch">Hold the arrows to walk.</span>
      </p>
    </header>

    <div class="stage" data-stage>
      <svg class="world" data-world viewBox={`0 0 1200 540`} preserveAspectRatio="xMinYMid slice" aria-hidden="true">
        <defs>
          <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="8" class="j-hatch" />
          </pattern>
        </defs>

        <!-- Sky: drifting clouds and a sun -->
        <g class="clouds">
          {Array.from({ length: 14 }, (_, i) => (
            <path
              class="j-line cloud"
              style={`--d:${18 + (i % 4) * 6}s`}
              transform={`translate(${200 + i * 760} ${80 + ((i * 37) % 90)})`}
              d="M0 30c-18 0-18-26 2-24 4-16 30-16 34 0 14-6 28 4 22 18 10 4 4 16-6 16H4c-10 0-14-6-4-10z"
            />
          ))}
        </g>

        <!-- Hills far away -->
        <path
          class="j-line hills"
          d={`M0 ${G - 40} ${Array.from({ length: Math.ceil(WORLD / 300) + 1 }, (_, i) => `Q ${i * 300 + 150} ${G - 90 - ((i * 53) % 50)} ${(i + 1) * 300} ${G - 40}`).join(' ')}`}
        />

        <!-- The path -->
        <line class="j-line ground" x1="0" y1={G} x2={WORLD} y2={G} />
        <line class="j-line road" x1="0" y1={G + 26} x2={WORLD} y2={G + 26} />

        <!-- 1. School, Kankavli -->
        <g transform={`translate(${stops[0].x} ${G})`}>
          <path class="j-fill" d="M-170 -130h340v130h-340z" />
          <path class="j-fill" d="M-190 -130 0 -205 190 -130z" />
          <rect class="j-ink" x="-170" y="-112" width="340" height="22" />
          <text class="j-text j-text--rev" x="0" y="-95" text-anchor="middle">SCHOOL</text>
          <path class="j-fill" d="M-24 -62h48v62h-48z" />
          {[-130, -80, 56, 106].map((x) => <rect class="j-fill" x={x} y="-70" width="34" height="30" />)}
          <line class="j-line" x1="215" y1="0" x2="215" y2="-200" />
          <path class="j-ink flag" d="M215 -200c18-6 34 6 52 0v28c-18 6-34-6-52 0z" />
          <g transform="translate(-280 0)">
            <line class="j-line" x1="0" y1="0" x2="0" y2="-90" />
            <rect class="j-fill" x="-62" y="-118" width="124" height="34" rx="4" />
            <text class="j-text" x="0" y="-95" text-anchor="middle">KANKAVLI</text>
          </g>
          <g transform="translate(300 0)">
            <line class="j-line" x1="0" y1="0" x2="0" y2="-60" />
            <circle class="j-fill" cx="0" cy="-92" r="38" />
            <circle class="j-fill tree-in" cx="-14" cy="-98" r="14" fill="url(#hatch)" />
          </g>
        </g>

        <!-- 2. Mumbai: skyline and a local train -->
        <g transform={`translate(${stops[1].x} ${G})`}>
          {[
            [-320, 150, 70], [-250, 220, 60], [-190, 180, 80], [-110, 260, 56], [-54, 200, 70], [16, 290, 64], [80, 210, 76], [156, 250, 58], [214, 170, 80],
          ].map(([x, h, w]) => (
            <g>
              <rect class="j-fill" x={x} y={-h} width={w} height={h - 70} />
              {Array.from({ length: Math.floor((h - 90) / 34) }, (_, r) => (
                <line class="j-line j-thin" x1={x + 12} y1={-h + 22 + r * 34} x2={x + w - 12} y2={-h + 22 + r * 34} />
              ))}
            </g>
          ))}
          <clipPath id="trainclip">
            <rect x="-360" y="-90" width="720" height="92" />
          </clipPath>
          <g clip-path="url(#trainclip)">
            <g class="train">
              {[0, 1, 2].map((c) => (
                <g transform={`translate(${-720 + c * 250} 0)`}>
                  <rect class="j-fill" x="0" y="-72" width="236" height="56" rx="8" />
                  {[16, 70, 124, 178].map((wx) => <rect class="j-ink" x={wx} y="-62" width="40" height="22" rx="3" />)}
                  <circle class="j-fill" cx="40" cy="-12" r="10" />
                  <circle class="j-fill" cx="196" cy="-12" r="10" />
                </g>
              ))}
            </g>
          </g>
          <g transform="translate(330 0)">
            <line class="j-line" x1="0" y1="0" x2="0" y2="-90" />
            <rect class="j-fill" x="-56" y="-118" width="112" height="34" rx="4" />
            <text class="j-text" x="0" y="-95" text-anchor="middle">MUMBAI</text>
          </g>
        </g>

        <!-- 3. Café 101 -->
        <g transform={`translate(${stops[2].x} ${G})`}>
          <path class="j-fill" d="M-140 -120h280v120h-280z" />
          <path class="j-ink" d="M-160 -120h320l-14 34h-292z" />
          {[-120, -70, -20, 30, 80].map((x) => <path class="j-fill" d={`M${x} -120h26l-6 34h-26z`} />)}
          <rect class="j-fill" x="-90" y="-176" width="180" height="40" rx="4" />
          <text class="j-text j-text--big" x="0" y="-148" text-anchor="middle">CAFÉ 101</text>
          <path class="j-fill" d="M-110 -70h90v70h-90z" />
          <path class="j-fill" d="M20 -70h90v40h-90z" />
          <g transform="translate(200 0)">
            <path class="j-line" d="M-34 0l14-90M34 0l-14-90" />
            <rect class="j-ink" x="-42" y="-110" width="84" height="64" rx="3" />
            <text class="j-text j-text--rev j-text--small" x="0" y="-86" text-anchor="middle">MENU</text>
            <text class="j-text j-text--rev j-text--small" x="0" y="-62" text-anchor="middle">MAGGIZZA</text>
          </g>
          <g transform="translate(-230 0)">
            <line class="j-line" x1="0" y1="0" x2="0" y2="-40" />
            <line class="j-line" x1="-30" y1="-40" x2="30" y2="-40" />
            <path class="j-fill" d="M-12 -58h24v18h-24z" />
            <path class="j-line steam" d="M-4 -66c-6-8 6-12 0-20M6 -66c-6-8 6-12 0-20" />
          </g>
        </g>

        <!-- 4. Engineering: college, debate podium, hackathon laptop -->
        <g transform={`translate(${stops[3].x} ${G})`}>
          <path class="j-fill" d="M-210 -150h420v150h-420z" />
          <path class="j-fill" d="M-235 -150 0 -215 235 -150z" />
          {[-170, -110, -50, 10, 70, 130].map((x) => <rect class="j-fill" x={x} y="-140" width="30" height="140" />)}
          <rect class="j-ink" x="-235" y="-162" width="470" height="14" />
          <text class="j-text" x="0" y="-170" text-anchor="middle">ENGINEERING</text>
          <g transform="translate(320 0)">
            <path class="j-fill" d="M-36 0l8-80h56l8 80z" />
            <line class="j-line" x1="10" y1="-80" x2="22" y2="-112" />
            <circle class="j-ink" cx="23" cy="-116" r="6" />
            <text class="j-text j-text--small" x="0" y="-36" text-anchor="middle">DEBATE</text>
          </g>
          <g transform="translate(-330 0)">
            <path class="j-fill" d="M-60 0v-40h120v40z" />
            <path class="j-fill" d="M-40 -40l6-52h68l6 52z" />
            <text class="j-text j-text--small" x="0" y="-60" text-anchor="middle">&lt;/&gt;</text>
            <path class="j-line spark" d="M44 -100l10-10M52 -86h14M30 -110l2-14" />
            <text class="j-text j-text--small" x="0" y="-14" text-anchor="middle">HACKATHON</text>
          </g>
        </g>

        <!-- 5. Pune: office, concert, gym -->
        <g transform={`translate(${stops[4].x} ${G})`}>
          <path class="j-fill" d="M-90 -250h180v250h-180z" />
          {Array.from({ length: 6 }, (_, r) => [-62, -16, 30].map((x) => <rect class="j-ink" x={x} y={-228 + r * 34} width="32" height="18" />))}
          <rect class="j-fill" x="-70" y="-300" width="140" height="34" rx="4" />
          <text class="j-text" x="0" y="-277" text-anchor="middle">PUNE</text>
          <g transform="translate(-320 0)">
            <path class="j-fill" d="M-110 0v-40h220v40z" />
            <path class="j-fill" d="M-120 -40v-90M120 -40v-90" />
            <path class="j-ink" d="M-130 -150h260v20h-260z" />
            <rect class="j-fill" x="-100" y="-96" width="34" height="56" />
            <rect class="j-fill" x="66" y="-96" width="34" height="56" />
            <g class="notes">
              <path class="j-ink note n1" d="M-20 -100v-30l18-6v30" />
              <circle class="j-ink note n1" cx="-24" cy="-100" r="6" />
              <path class="j-ink note n2" d="M20 -110v-26" />
              <circle class="j-ink note n2" cx="16" cy="-110" r="6" />
            </g>
            <text class="j-text j-text--small" x="0" y="-12" text-anchor="middle">CONCERTS</text>
          </g>
          <g transform="translate(300 0)">
            <path class="j-line" d="M-60 0v-90M60 0v-90M-60 -70h120" />
            <rect class="j-ink" x="-50" y="-88" width="14" height="36" rx="3" />
            <rect class="j-ink" x="36" y="-88" width="14" height="36" rx="3" />
            <line class="j-line j-thick" x1="-36" y1="-70" x2="36" y2="-70" />
            <text class="j-text j-text--small" x="0" y="-12" text-anchor="middle">GYM</text>
          </g>
        </g>

        <!-- 6. Travel: mountains, a plane, a scooter, a boat -->
        <g transform={`translate(${stops[5].x} ${G})`}>
          <path class="j-fill" d="M-380 0l140-200 80 90 90-150 120 180 70-60 120 140z" />
          <path class="j-ink" d="M-240 -200l-26 38 18-8 10 14 16-14 12 6zM10 -260l-30 44 22-10 10 16 18-16 18 8z" />
          <g class="plane">
            <path class="j-ink" d="M0 0l60-6 30-24h12l-14 26 40-4 10-12h8l-4 18 4 18h-8l-10-12-40-4 14 26h-12l-30-24-60-6z" />
          </g>
          <g transform="translate(-300 0)">
            <circle class="j-fill" cx="-26" cy="-16" r="16" />
            <circle class="j-fill" cx="30" cy="-16" r="16" />
            <path class="j-fill" d="M-26 -16h26l14-30h20l-4 30" />
            <line class="j-line" x1="34" y1="-46" x2="44" y2="-62" />
          </g>
          <g transform="translate(310 0)">
            <path class="j-line wave" d="M-90 -6q15-10 30 0t30 0 30 0 30 0 30 0 30 0" />
            <path class="j-fill" d="M-50 -20h100l-16 18h-68z" />
            <path class="j-fill" d="M0 -26v-90l46 80z" />
          </g>
          <g transform="translate(120 0)">
            <line class="j-line" x1="0" y1="0" x2="0" y2="-60" />
            <rect class="j-fill" x="-80" y="-92" width="160" height="34" rx="4" />
            <text class="j-text" x="0" y="-69" text-anchor="middle">15+ COUNTRIES</text>
          </g>
        </g>

        <!-- 7. Family hospital, Kankavli -->
        <g transform={`translate(${stops[6].x} ${G})`}>
          <path class="j-fill" d="M-170 -170h340v170h-340z" />
          {[-130, -70, 40, 100].map((x) => [-140, -90].map((y) => <rect class="j-fill" x={x} y={y} width="34" height="30" />))}
          <path class="j-fill" d="M-30 -66h60v66h-60z" />
          <g transform="translate(0 -210)">
            <rect class="j-fill" x="-40" y="-40" width="80" height="80" rx="6" />
            <path class="j-ink" d="M-10 -28h20v18h18v20h-18v18h-20v-18h-18v-20h18z" />
          </g>
          <rect class="j-ink" x="-170" y="-186" width="340" height="16" />
          <text class="j-text" x="0" y="-38" text-anchor="middle" transform="translate(0 -110)">HOSPITAL</text>
          <g transform="translate(-260 0)">
            <line class="j-line" x1="0" y1="0" x2="0" y2="-90" />
            <rect class="j-fill" x="-62" y="-118" width="124" height="34" rx="4" />
            <text class="j-text" x="0" y="-95" text-anchor="middle">KANKAVLI</text>
          </g>
        </g>

        <!-- 8. Masters' Union -->
        <g transform={`translate(${stops[7].x} ${G})`}>
          <path class="j-fill" d="M-220 -200h440v200h-440z" />
          {Array.from({ length: 4 }, (_, r) => Array.from({ length: 8 }, (_, c) => <rect class="j-fill" x={-200 + c * 52} y={-184 + r * 44} width="40" height="30" />))}
          <rect class="j-ink" x="-220" y="-232" width="440" height="32" />
          <text class="j-text j-text--rev" x="0" y="-210" text-anchor="middle">MASTERS' UNION</text>
          <g class="cap" transform="translate(280 -60)">
            <path class="j-ink" d="M-40 0l40-18 40 18-40 18z" />
            <path class="j-fill" d="M-22 8v18c14 10 30 10 44 0v-18" />
            <line class="j-line" x1="34" y1="3" x2="34" y2="30" />
          </g>
        </g>

        <!-- 9. Building things -->
        <g transform={`translate(${stops[8].x} ${G})`}>
          <path class="j-fill" d="M-360 -60h300v14h-300z" />
          <path class="j-line" d="M-340 -46V0M-80 -46V0" />
          <rect class="j-ink" x="-320" y="-82" width="70" height="22" rx="3" />
          <path class="j-line" d="M-180 -60l40-40M-160 -60l20-20" />
          {[
            [190, 'MEDDRAFT'],
            [400, 'KUCHU PUCHU'],
            [610, 'MU CENTRAL'],
          ].map(([x, t]) => (
            <g transform={`translate(${x} 0)`}>
              <line class="j-line" x1="0" y1="0" x2="0" y2="-110" />
              <rect class="j-fill" x="-76" y="-148" width="152" height="40" rx="4" />
              <text class="j-text" x="0" y="-121" text-anchor="middle">{t}</text>
            </g>
          ))}
          <g transform="translate(800 0)">
            <line class="j-line" x1="0" y1="0" x2="0" y2="-120" />
            <path class="j-fill" d="M-40 -150h70l20 18-20 18h-70z" />
            <text class="j-text" x="-2" y="-126" text-anchor="middle">NEXT?</text>
          </g>
        </g>

        <!-- Shivam. Feet at the origin; grows up as he walks. -->
        <g class="hero" data-hero-walker>
          <g data-body>
            <g class="limb" data-leg-back><line class="j-limb" x1="0" y1="-62" x2="0" y2="-8" /><ellipse class="j-ink" cx="6" cy="-4" rx="12" ry="6" /></g>
            <g class="limb" data-arm-back><line class="j-limb j-limb--arm" x1="0" y1="-128" x2="0" y2="-84" /></g>
            <rect class="j-ink" data-pack x="-34" y="-128" width="20" height="44" rx="6" />
            <path class="j-ink" d="M-22 -136c0-8 6-12 22-12s22 4 22 12v66c0 6-4 10-10 10h-24c-6 0-10-4-10-10z" />
            <g class="limb" data-leg-front><line class="j-limb" x1="0" y1="-62" x2="0" y2="-8" /><ellipse class="j-ink" cx="6" cy="-4" rx="12" ry="6" /></g>
            <circle class="j-fill j-head" cx="2" cy="-170" r="22" />
            <path class="j-ink" d="M-20 -176c0-20 16-28 30-24 12 4 16 14 14 22-6-6-14-8-22-6-8 2-14 6-22 8z" />
            <path class="j-ink" data-beard d="M-6 -158c4 14 24 16 30 -2 2 10-2 22-14 26-10 2-18-8-16-24z" />
            <circle class="j-ink" cx="12" cy="-172" r="2.6" />
            <path class="j-line j-thin" d="M8 -160q6 4 12 0" />
            <g class="limb" data-arm-front><line class="j-limb j-limb--arm" x1="0" y1="-128" x2="0" y2="-84" /></g>
          </g>
        </g>
      </svg>

      <article class="jcard" data-card aria-live="polite">
        <p class="jcard__when pen" data-card-when></p>
        <h2 class="jcard__title" data-card-title></h2>
        <p class="jcard__text" data-card-text></p>
        <p class="jcard__links" data-card-links hidden>
          <a href="/#products">See the products</a>
          <a href="/future/">Build together</a>
        </p>
      </article>

      <div class="jpad">
        <button class="jbtn" type="button" data-left aria-label="Walk back">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button class="jbtn jbtn--wide" type="button" data-auto aria-pressed="false">Walk for me</button>
        <button class="jbtn" type="button" data-right aria-label="Walk forward">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <nav class="jmap" aria-label="Stops on the journey">
      <div class="jmap__line"><span data-map-fill></span></div>
      <ol>
        {
          stops.map((s, i) => (
            <li>
              <button type="button" class="jmap__stop" data-stop={i} title={s.title}>
                <span class="jmap__dot" />
                <span class="jmap__label">{s.title.split(',')[0]}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <noscript>
    <section class="sheet" style="padding-block: 2rem">
      <ol class="line">
        {stops.map((s) => <li><span class="when">{s.when}</span><div><strong>{s.title}</strong><span class="what">{s.text}</span></div></li>)}
      </ol>
    </section>
  </noscript>
</Base>

<script define:vars={{ stops, WORLD }}>
  window.__journey = { stops, WORLD };
</script>

<script>
  type Stop = { key: string; when: string; title: string; text: string; x: number };
  const { stops, WORLD } = (window as unknown as { __journey: { stops: Stop[]; WORLD: number } }).__journey;

  const root = document.querySelector<HTMLElement>('[data-journey]')!;
  const stage = root.querySelector<HTMLElement>('[data-stage]')!;
  const svg = root.querySelector<SVGSVGElement>('[data-world]')!;
  const walker = root.querySelector<SVGGElement>('[data-hero-walker]')!;
  const body = root.querySelector<SVGGElement>('[data-body]')!;
  const legF = root.querySelector<SVGGElement>('[data-leg-front]')!;
  const legB = root.querySelector<SVGGElement>('[data-leg-back]')!;
  const armF = root.querySelector<SVGGElement>('[data-arm-front]')!;
  const armB = root.querySelector<SVGGElement>('[data-arm-back]')!;
  const beard = root.querySelector<SVGPathElement>('[data-beard]')!;
  const pack = root.querySelector<SVGRectElement>('[data-pack]')!;
  const card = root.querySelector<HTMLElement>('[data-card]')!;
  const cWhen = root.querySelector<HTMLElement>('[data-card-when]')!;
  const cTitle = root.querySelector<HTMLElement>('[data-card-title]')!;
  const cText = root.querySelector<HTMLElement>('[data-card-text]')!;
  const cLinks = root.querySelector<HTMLElement>('[data-card-links]')!;
  const fill = root.querySelector<HTMLElement>('[data-map-fill]')!;
  const stopBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-stop]')];
  const autoBtn = root.querySelector<HTMLButtonElement>('[data-auto]')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const H = 540;
  const START = 160;
  const END = WORLD - 260;
  const SPEED = 300;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  let x = START;
  let dir = 1;
  let hold = 0; // -1, 0, 1 from keys or buttons
  let auto = false;
  let target: number | null = null;
  let pauseUntil = 0;
  let phase = 0;
  let shown = -1;
  let last = performance.now();

  // Grows from a kid at school to full height by engineering; the beard comes in from Pune.
  const growth = (px: number) => clamp((px - stops[0].x + 300) / (stops[3].x - stops[0].x + 300));
  const beardAt = (px: number) => clamp((px - stops[4].x + 250) / (stops[5].x - stops[4].x));
  const packOn = (px: number) => px < stops[2].x - 300 || (px > stops[3].x - 400 && px < stops[3].x + 450) || (px > stops[5].x - 500 && px < stops[5].x + 500);

  const view = () => {
    const w = (stage.clientWidth / stage.clientHeight) * H;
    const cam = clamp(x - w * 0.32, 0, Math.max(0, WORLD - w));
    svg.setAttribute('viewBox', `${cam} 0 ${w} ${H}`);
  };

  const showStop = (i: number) => {
    if (i === shown) return;
    shown = i;
    stopBtns.forEach((b, k) => b.setAttribute('aria-current', String(k === i)));
    if (i < 0) {
      card.classList.remove('is-on');
      return;
    }
    const s = stops[i];
    cWhen.textContent = s.when;
    cTitle.textContent = s.title;
    cText.textContent = s.text;
    cLinks.hidden = s.key !== 'build';
    card.classList.remove('is-on');
    void card.offsetWidth;
    card.classList.add('is-on');
  };

  const draw = (moving: boolean) => {
    const g = 0.62 + 0.38 * growth(x);
    walker.setAttribute('transform', `translate(${x} 430) scale(${dir * g} ${g})`);
    beard.style.opacity = String(beardAt(x));
    beard.style.transform = `scale(1, ${0.4 + 0.6 * beardAt(x)})`;
    pack.style.opacity = packOn(x) ? '1' : '0';
    const swing = moving && !still ? Math.sin(phase) : 0;
    legF.setAttribute('transform', `rotate(${swing * 26} 0 -62)`);
    legB.setAttribute('transform', `rotate(${-swing * 26} 0 -62)`);
    armF.setAttribute('transform', `rotate(${-swing * 24} 0 -128)`);
    armB.setAttribute('transform', `rotate(${swing * 24} 0 -128)`);
    body.setAttribute('transform', `translate(0 ${moving && !still ? -Math.abs(Math.sin(phase)) * 4 : 0})`);
    fill.style.transform = `scaleX(${(x - START) / (END - START)})`;
    let near = -1;
    stops.forEach((s, i) => {
      if (Math.abs(x - s.x) < 420) near = i;
    });
    showStop(near);
    view();
  };

  const tick = (now: number) => {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    let v = 0;
    if (hold) {
      v = hold;
      target = null;
      auto = false;
    } else if (target !== null) {
      const d = target - x;
      if (Math.abs(d) < 6) {
        x = target;
        target = null;
      } else v = Math.sign(d);
    } else if (auto && now > pauseUntil) {
      v = 1;
      // Pause at each stop so the card can be read.
      const next = stops.find((s) => s.x > x + 1);
      if (next && x + SPEED * 0.7 * dt >= next.x) {
        x = next.x;
        pauseUntil = now + 2600;
        v = 0;
      }
      if (x >= END) auto = false;
    }
    autoBtn.setAttribute('aria-pressed', String(auto));
    autoBtn.textContent = auto ? 'Pause' : 'Walk for me';
    if (v) {
      dir = v;
      const speed = auto && target === null && !hold ? SPEED * 0.7 : SPEED;
      x = clamp(x + v * speed * dt, START, END);
      phase += speed * dt * 0.045;
      root.classList.add('has-walked');
    }
    draw(v !== 0);
    requestAnimationFrame(tick);
  };

  // ---------- Controls ----------
  const keys = new Set<string>();
  const fromKeys = () => {
    hold = (keys.has('right') ? 1 : 0) - (keys.has('left') ? 1 : 0);
  };
  addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLElement && e.target.closest('input, textarea')) return;
    const k = e.key;
    if (k === 'ArrowRight' || k === 'd' || k === 'D') keys.add('right');
    else if (k === 'ArrowLeft' || k === 'a' || k === 'A') keys.add('left');
    else return;
    e.preventDefault();
    fromKeys();
  });
  addEventListener('keyup', (e) => {
    const k = e.key;
    if (k === 'ArrowRight' || k === 'd' || k === 'D') keys.delete('right');
    if (k === 'ArrowLeft' || k === 'a' || k === 'A') keys.delete('left');
    fromKeys();
  });
  addEventListener('blur', () => {
    keys.clear();
    hold = 0;
  });

  const holdButton = (btn: HTMLElement, v: number) => {
    const down = (e: PointerEvent) => {
      e.preventDefault();
      btn.setPointerCapture(e.pointerId);
      hold = v;
    };
    const up = () => (hold = 0);
    btn.addEventListener('pointerdown', down);
    btn.addEventListener('pointerup', up);
    btn.addEventListener('pointercancel', up);
    btn.addEventListener('contextmenu', (e) => e.preventDefault());
    // Keyboard users: one press moves to the next or previous stop.
    btn.addEventListener('click', (e) => {
      if ((e as PointerEvent).pointerType) return;
      const i = v > 0 ? stops.findIndex((s) => s.x > x + 1) : stops.map((s) => s.x).findLastIndex((sx) => sx < x - 1);
      if (i >= 0) goTo(i);
    });
  };
  holdButton(root.querySelector('[data-right]')!, 1);
  holdButton(root.querySelector('[data-left]')!, -1);

  const goTo = (i: number) => {
    auto = false;
    if (still) {
      x = stops[i].x;
      dir = 1;
      draw(false);
    } else target = stops[i].x;
  };
  stopBtns.forEach((b, i) => b.addEventListener('click', () => goTo(i)));

  autoBtn.addEventListener('click', () => {
    if (still) {
      const i = stops.findIndex((s) => s.x > x + 1);
      return goTo(i >= 0 ? i : 0);
    }
    if (!auto && x >= END - 1) x = START;
    auto = !auto;
    target = null;
    pauseUntil = 0;
  });

  addEventListener('resize', () => draw(false));
  draw(false);
  requestAnimationFrame(tick);
</script>

