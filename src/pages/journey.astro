---
// "Walk my journey": a small endless-runner, like the offline game in Chrome.
// Shivam runs one path through the places of his life, growing up (and growing a beard) as he goes.
// Space, ↑ or a tap jumps over what is in the way. Two stops are side quests: the path branches off the
// main line, runs through them, and rejoins. Black and white line art, drawn in SVG.
import Base from '../layouts/Base.astro';

const STEP = 1050;
const FIRST = 700;
const stops = [
  { key: 'school', when: 'Up to Class X', title: 'Kankavli', text: 'Where I grew up and went to school.' },
  { key: 'mumbai', when: 'Class XI and XII', title: 'Mumbai', text: 'Off to the big city for junior college.' },
  { key: 'cafe', side: true, when: '2018', title: 'Café 101, back in Kankavli', text: 'After Class XII I opened a small café with my own money. Maggizza was on the menu.' },
  { key: 'college', when: '2018 to 2022', title: 'Engineering, NMIMS Mumbai', text: 'A B.Tech, hackathons, and chairing the NM Debate Society.' },
  { key: 'europe1', side: true, trip: true, when: '2022 · after engineering', title: 'Europe', text: 'Degree done. First stop off the main road: Europe.' },
  { key: 'pune', when: '2022 to 2026', title: 'TresVista, Pune', text: 'Four years building data pipelines and dashboards. Evenings at concerts and the gym.' },
  { key: 'europe2', side: true, trip: true, when: '2023 · a year into the job', title: 'Europe, again', text: 'One year in at TresVista, and back to Europe.' },
  { key: 'china', side: true, trip: true, when: '2026 · after my last year at TresVista', title: 'China', text: 'Four years of work, closed out with a trip to China.' },
  { key: 'sea', side: true, trip: true, when: '2026 · the gap', title: 'Thailand and Vietnam', text: 'After quitting, before Masters\' Union. Vietnam by scooter, between the limestone hills.' },
  { key: 'hospital', when: 'The gap', title: 'The family hospital, Kankavli', text: 'Back home before Masters\' Union, working on how the hospital runs.' },
  { key: 'mu', when: '2026 on', title: "Masters' Union", text: 'Post Graduate Programme in Technology & Business Management.' },
  { key: 'build', when: 'Now', title: 'Building things', text: 'MedDraft, Kuchu Puchu and MU Central. 15+ countries so far, and the path keeps going.' },
].map((s, i) => ({ ...s, x: FIRST + i * STEP }));
const WORLD = FIRST + (stops.length - 1) * STEP + 900;
const at = Object.fromEntries(stops.map((s) => [s.key, s.x])) as Record<string, number>;
const G = 430;

// Side quests: the path climbs off the main line, runs flat through the stop, and comes back down.
const LIFT = 110;
const RAMP = 140;
const FLAT = 300;
const sides = stops.filter((s) => s.side).map((s) => s.x);
const smooth = (t: number) => t * t * (3 - 2 * t);
const groundY = (x: number) => {
  for (const sx of sides) {
    const d = Math.abs(x - sx);
    if (d <= FLAT) return G - LIFT;
    if (d < FLAT + RAMP) return G - LIFT * smooth((FLAT + RAMP - d) / RAMP);
  }
  return G;
};
const ridge = (sx: number) =>
  `M${sx - FLAT - RAMP} ${G} C${sx - FLAT - RAMP / 2} ${G} ${sx - FLAT - RAMP / 2} ${G - LIFT} ${sx - FLAT} ${G - LIFT} H${sx + FLAT} C${sx + FLAT + RAMP / 2} ${G - LIFT} ${sx + FLAT + RAMP / 2} ${G} ${sx + FLAT + RAMP} ${G}`;

// Obstacles between stops, themed to that part of the road. Never near a stop or on a ramp.
const kinds = ['books', 'suitcase', 'cone', 'bug', 'suitcase', 'deadline', 'deadline', 'suitcase', 'rock', 'cone', 'papers'];
const obstacles: { x: number; kind: string; y: number }[] = [];
stops.slice(0, -1).forEach((s, i) => {
  const kind = kinds[i];
  const spots = i === 0 ? [0.45] : [0.28, 0.7];
  for (const f of spots) {
    const x = Math.round(s.x + STEP * f);
    // Skip anything on or near a side-quest ramp, and keep every pair far enough apart to land between.
    const onRamp = sides.some((sx) => Math.abs(x - sx) > FLAT - 80 && Math.abs(x - sx) < FLAT + RAMP + 100);
    const tooClose = obstacles.some((o) => Math.abs(o.x - x) < 380);
    if (!onRamp && !tooClose) obstacles.push({ x, kind, y: groundY(x) });
  }
});
---

<Base
  title="Run my journey"
  description="A small game: walk with Shivam Birmole from school in Kankavli to Mumbai, a café, engineering, Pune, travel, the family hospital and Masters' Union."
