            </g>
          ))}
          <g transform="translate(800 0)">
            <line class="j-line" x1="0" y1="0" x2="0" y2="-120" />
            <path class="j-fill" d="M-40 -150h70l20 18-20 18h-70z" />
            <text class="j-text" x="-2" y="-126" text-anchor="middle">NEXT?</text>
          </g>
        </g>

        <!-- Things in the way -->
        {obstacles.map((o) => (
          <g class={`obs obs--${o.kind}`} transform={`translate(${o.x} ${o.y})`}>
            {o.kind === 'books' && (
              <g>
                <rect class="j-fill" x="-24" y="-14" width="48" height="14" />
                <rect class="j-ink" x="-20" y="-26" width="42" height="12" />
                <rect class="j-fill" x="-22" y="-40" width="40" height="14" />
              </g>
            )}
            {o.kind === 'suitcase' && (
              <g>
                <rect class="j-fill" x="-26" y="-38" width="52" height="38" rx="5" />
                <path class="j-line" d="M-10 -38v-8h20v8M-26 -20h52" />
              </g>
            )}
            {o.kind === 'cone' && (
              <g>
                <path class="j-fill" d="M-22 0l16-44h12l16 44z" />
                <path class="j-ink" d="M-14 -20h28l-4 -10h-20z" />
              </g>
            )}
            {o.kind === 'bug' && (
              <g>
                <ellipse class="j-ink" cx="0" cy="-16" rx="22" ry="14" />
                <path class="j-line" d="M-14 -6l-10 6M0 -4v8M14 -6l10 6M-10 -28l-8-10M10 -28l8-10" />
                <text class="j-text j-text--rev j-text--small" x="0" y="-11" text-anchor="middle">BUG</text>
              </g>
            )}
            {o.kind === 'deadline' && (
              <g>
                <rect class="j-ink" x="-40" y="-36" width="80" height="36" rx="3" />
                <text class="j-text j-text--rev j-text--small" x="0" y="-13" text-anchor="middle">DEADLINE</text>
              </g>
            )}
            {o.kind === 'rock' && <path class="j-fill" d="M-28 0l6-26 18-12 22 8 10 30z" fill="url(#hatch)" />}
            {o.kind === 'papers' && (
              <g>
                <path class="j-fill" d="M-26 0v-12h52v12zM-22 -12v-12h46v12zM-24 -24v-12h48v12z" />
                <text class="j-text j-text--small" x="0" y="-27" text-anchor="middle">FORMS</text>
              </g>
            )}
          </g>
        ))}

        <!-- Shivam. Feet at the origin; grows up as he runs. -->
        <g class="hero" data-hero-walker>
          <g data-body>
            <g class="limb" data-leg-back><line class="j-limb" x1="0" y1="-62" x2="0" y2="-8" /><ellipse class="j-ink" cx="6" cy="-4" rx="12" ry="6" /></g>
            <g class="limb" data-arm-back><line class="j-limb j-limb--arm" x1="0" y1="-128" x2="0" y2="-84" /></g>
            <rect class="j-ink" data-pack x="-34" y="-128" width="20" height="44" rx="6" />
            <path class="j-ink" d="M-22 -136c0-8 6-12 22-12s22 4 22 12v66c0 6-4 10-10 10h-24c-6 0-10-4-10-10z" />
            <g class="limb" data-leg-front><line class="j-limb" x1="0" y1="-62" x2="0" y2="-8" /><ellipse class="j-ink" cx="6" cy="-4" rx="12" ry="6" /></g>
            <circle class="j-fill j-head" cx="2" cy="-170" r="22" />
            <path class="j-ink" d="M-20 -176c0-20 16-28 30-24 12 4 16 14 14 22-6-6-14-8-22-6-8 2-14 6-22 8z" />
            <path class="j-ink" data-beard d="M-6 -158c4 14 24 16 30 -2 2 10-2 22-14 26-10 2-18-8-16-24z" />
            <circle class="j-ink" cx="12" cy="-172" r="2.6" />
            <path class="j-line j-thin" d="M8 -160q6 4 12 0" />
            <g class="limb" data-arm-front><line class="j-limb j-limb--arm" x1="0" y1="-128" x2="0" y2="-84" /></g>
          </g>
        </g>
      </svg>

      <article class="jcard" data-card aria-live="polite">
        <p class="jcard__when pen"><span data-card-when></span> <span class="jcard__side" data-card-side hidden>side quest</span></p>
        <h2 class="jcard__title" data-card-title></h2>
        <p class="jcard__text" data-card-text></p>
      </article>

      <p class="jhud pen" aria-hidden="true"><span data-hud-stops>0</span> of {stops.length} stops · <span data-hud-trips>0</span> stumbles</p>

      <div class="jscreen" data-screen>
        <div class="jscreen__box">
          <h2 class="jscreen__title" data-screen-title>Run my journey</h2>
          <p class="jscreen__text" data-screen-text>
            Press <kbd>Space</kbd> or tap to start. Jump over whatever is in the way.
          </p>
          <p class="jscreen__links" data-screen-links hidden>
            <button class="jbtn jbtn--wide" type="button" data-again>Run it again</button>
            <a href="/#products">See the products</a>
            <a href="/future/">Build together</a>
          </p>
        </div>
      </div>

      <button class="jjump" type="button" data-jump>Jump</button>
    </div>

    <ol class="jmap" aria-label="Stops on the journey">
      <li class="jmap__line" aria-hidden="true"><span data-map-fill></span></li>
      {
        stops.map((s, i) => (
          <li class="jmap__stop" data-stop={i}>
            <span class="jmap__dot" />
            <span class="jmap__label">{s.side ? `${s.title.split(',')[0]} ↗` : s.title.split(',')[0]}</span>
          </li>
        ))
      }
    </ol>

    <details class="jstory sheet">
      <summary>Skip the game and read the story</summary>
      <ol class="line">
        {stops.map((s) => <li><span class="when">{s.when}</span><div><strong>{s.title}{s.side ? ' (side quest)' : ''}</strong><span class="what">{s.text}</span></div></li>)}
      </ol>
    </details>
  </section>

  <noscript>
    <section class="sheet" style="padding-block: 2rem">
      <ol class="line">
        {stops.map((s) => <li><span class="when">{s.when}</span><div><strong>{s.title}</strong><span class="what">{s.text}</span></div></li>)}
      </ol>
    </section>
  </noscript>
</Base>

<script define:vars={{ stops, WORLD, obstacles, sides, G, LIFT, RAMP, FLAT }}>
  window.__journey = { stops, WORLD, obstacles, sides, G, LIFT, RAMP, FLAT };
</script>

<script>
  type Stop = { key: string; side?: boolean; trip?: boolean; when: string; title: string; text: string; x: number };
  type Obs = { x: number; kind: string; y: number };
  const J = (window as unknown as { __journey: { stops: Stop[]; WORLD: number; obstacles: Obs[]; sides: number[]; G: number; LIFT: number; RAMP: number; FLAT: number } }).__journey;
  const { stops, WORLD, obstacles, sides, G, LIFT, RAMP, FLAT } = J;

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
  const root = $<HTMLElement>('[data-journey]');
  const stage = $<HTMLElement>('[data-stage]');
  const svg = $<SVGSVGElement>('[data-world]');
  const walker = $<SVGGElement>('[data-hero-walker]');
  const body = $<SVGGElement>('[data-body]');
  const legF = $<SVGGElement>('[data-leg-front]');
  const legB = $<SVGGElement>('[data-leg-back]');
  const armF = $<SVGGElement>('[data-arm-front]');
  const armB = $<SVGGElement>('[data-arm-back]');
  const beard = $<SVGPathElement>('[data-beard]');
  const pack = $<SVGRectElement>('[data-pack]');
  const card = $<HTMLElement>('[data-card]');
  const screen = $<HTMLElement>('[data-screen]');
  const sTitle = $<HTMLElement>('[data-screen-title]');
  const sText = $<HTMLElement>('[data-screen-text]');
  const sLinks = $<HTMLElement>('[data-screen-links]');
  const hudStops = $<HTMLElement>('[data-hud-stops]');
  const hudTrips = $<HTMLElement>('[data-hud-trips]');
  const fill = $<HTMLElement>('[data-map-fill]');
  const dots = [...document.querySelectorAll<HTMLElement>('[data-stop]')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const H = 540;
  const START = 160;
  const END = WORLD - 300;
  const GRAV = 2400;
  const JUMP = 800;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const groundY = (x: number) => {
    for (const sx of sides) {
      const d = Math.abs(x - sx);
      if (d <= FLAT) return G - LIFT;
      if (d < FLAT + RAMP) return G - LIFT * smooth((FLAT + RAMP - d) / RAMP);
    }
    return G;
  };
  const names: Record<string, string> = {
    books: 'a pile of textbooks',
    suitcase: 'a suitcase',
    cone: 'a traffic cone',
    bug: 'a bug',
    deadline: 'a deadline',
    rock: 'a rock',
    papers: 'a stack of forms',
  };
  const hit: Record<string, [number, number]> = {
    books: [24, 38], suitcase: [26, 36], cone: [18, 40], bug: [22, 26], deadline: [38, 34], rock: [26, 32], papers: [24, 34],
  };

  type State = 'ready' | 'run' | 'down' | 'done';
  let state: State = 'ready';
  let x = START;
  let y = G;
  let vy = 0;
  let grounded = true;
  let phase = 0;
  let falls = 0;
  let reached = -1;
  let shown = -1;
  let fallT = 0;
  let last = performance.now();

  const at = Object.fromEntries(stops.map((s) => [s.key, s.x])) as Record<string, number>;
  const tripXs = stops.filter((s) => s.trip).map((s) => s.x);
  const growth = (px: number) => clamp((px - at.school + 300) / (at.college - at.school + 300));
  // Stubble in Pune, a full beard by China.
  const beardAt = (px: number) => clamp((px - at.pune + 250) / (at.china - at.pune));
  const packOn = (px: number) =>
    px < at.cafe - 300 || Math.abs(px - at.college) < 420 || tripXs.some((t) => Math.abs(px - t) < FLAT + RAMP + 60);
  const speed = () => 330 + Math.max(0, reached) * 14;

  const say = (title: string, html: string, links = false) => {
    sTitle.textContent = title;
    sText.innerHTML = html;
    sLinks.hidden = !links;
    screen.classList.add('is-on');
  };

  const showStop = (i: number) => {
    if (i === shown || i < 0) return;
    shown = i;
    const s = stops[i];
    $<HTMLElement>('[data-card-when]').textContent = s.when;
    const badge = $<HTMLElement>('[data-card-side]');
    badge.hidden = !s.side;
    badge.textContent = s.trip ? 'off the main road' : 'side quest';
    $<HTMLElement>('[data-card-title]').textContent = s.title;
    $<HTMLElement>('[data-card-text]').textContent = s.text;
    card.classList.remove('is-on');
    void card.offsetWidth;
    card.classList.add('is-on');
  };

  const view = () => {
    const w = (stage.clientWidth / stage.clientHeight) * H;
    const cam = clamp(x - w * 0.26, 0, Math.max(0, WORLD - w));
    svg.setAttribute('viewBox', `${cam} 0 ${w} ${H}`);
  };

  const draw = () => {
    const g = 0.62 + 0.38 * growth(x);
    const tilt = state === 'down' ? -78 * smooth(clamp(fallT / 0.35)) : 0;
    walker.setAttribute('transform', `translate(${x} ${y}) rotate(${tilt}) scale(${g} ${g})`);
    beard.style.opacity = String(beardAt(x));
    beard.style.transform = `scale(1, ${0.4 + 0.6 * beardAt(x)})`;
    pack.style.opacity = packOn(x) ? '1' : '0';
    const running = state === 'run' && grounded && !still;
    const sw = running ? Math.sin(phase) : 0;
    const air = state === 'run' && !grounded;
    legF.setAttribute('transform', `rotate(${air ? -32 : sw * 30} 0 -62)`);
    legB.setAttribute('transform', `rotate(${air ? 22 : -sw * 30} 0 -62)`);
    armF.setAttribute('transform', `rotate(${air ? -120 : -sw * 34} 0 -128)`);
    armB.setAttribute('transform', `rotate(${air ? 40 : sw * 34} 0 -128)`);
    body.setAttribute('transform', `translate(0 ${running ? -Math.abs(Math.sin(phase)) * 5 : 0})`);
    fill.style.transform = `scaleX(${clamp((x - START) / (END - START))})`;
    view();
  };

  const start = () => {
    screen.classList.remove('is-on');
    state = 'run';
    root.classList.add('is-playing');
  };

  const restart = () => {
    x = START;
    y = G;
    vy = 0;
    grounded = true;
    falls = 0;
    reached = -1;
    shown = -1;
    hudTrips.textContent = '0';
    hudStops.textContent = '0';
    dots.forEach((d) => d.classList.remove('is-passed'));
    card.classList.remove('is-on');
    start();
  };

  const getUp = () => {
    // Back to the last stop reached, a little before it.
    x = reached >= 0 ? stops[reached].x - 120 : START;
    y = groundY(x);
    vy = 0;
    grounded = true;
    fallT = 0;
    start();
  };

  const act = () => {
    if (state === 'ready') return start();
    if (state === 'down') return getUp();
    if (state === 'done') return restart();
    if (grounded) {
      vy = -JUMP;
      grounded = false;
    }
  };

  const tick = (now: number) => {
    const dt = Math.min(0.04, (now - last) / 1000);
    last = now;

    if (state === 'run') {
      const v = speed();
      x = Math.min(END, x + v * dt);
      phase += v * dt * 0.05;
      const floor = groundY(x);
      if (grounded) y = floor;
      else {
        vy += GRAV * dt;
        y += vy * dt;
        if (y >= floor) {
          y = floor;
          vy = 0;
          grounded = true;
        }
      }

      // Stops passed
      stops.forEach((s, i) => {
        if (i > reached && x >= s.x - 160) {
          reached = i;
          hudStops.textContent = String(i + 1);
          dots[i]?.classList.add('is-passed');
          showStop(i);
        }
      });

      // Collisions
      for (const o of obstacles) {
        const [hw, hh] = hit[o.kind];
        if (Math.abs(x - o.x) < hw + 10 && y > o.y - hh + 4) {
          state = 'down';
          fallT = 0;
          falls += 1;
          hudTrips.textContent = String(falls);
          root.classList.remove('is-playing');
          say('Oops.', `Tripped over ${names[o.kind]}. Press <kbd>Space</kbd> or tap to get up.`);
          break;
        }
      }

      if (x >= END) {
        state = 'done';
        root.classList.remove('is-playing');
        say(
          'You made it to now.',
          `All ${stops.length} stops, side quests included, with ${falls} ${falls === 1 ? 'stumble' : 'stumbles'} on the way. The path keeps going.`,
          true,
        );
      }
    } else if (state === 'down') {
      fallT += dt;
    }

    draw();
    requestAnimationFrame(tick);
  };

  // ---------- Input ----------
  addEventListener('keydown', (e) => {
    const k = e.key;
    if (k !== ' ' && k !== 'ArrowUp' && k !== 'w' && k !== 'W') return;
    const t = e.target;
    if (t instanceof Element && t.closest('a, button, input, textarea, summary, select') && !t.closest('[data-jump]')) return;
    e.preventDefault();
    if (!e.repeat) act();
  });
  stage.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('a, button')) return;
    e.preventDefault();
    act();
  });
  $<HTMLButtonElement>('[data-jump]').addEventListener('pointerdown', (e) => {
    e.preventDefault();
    act();
  });
  $<HTMLButtonElement>('[data-jump]').addEventListener('click', (e) => {
    if (!(e as PointerEvent).pointerType) act();
  });
  $<HTMLButtonElement>('[data-again]').addEventListener('click', restart);

  addEventListener('resize', draw);
  y = groundY(x);
  say('Run my journey', 'Press <kbd>Space</kbd> or tap to start. Jump over whatever is in the way.');
  draw();
  requestAnimationFrame(tick);
</script>

<style is:global>
  .journey {
    --j-paper: #f6f5f1;
    --j-ink: #141414;
    --j-soft: #5c5c5c;
    padding-top: var(--space-4);
    background: var(--j-paper);
    color: var(--j-ink);
  }

  :root[data-theme='dark'] .journey {
    --j-paper: #151515;
    --j-ink: #efefea;
    --j-soft: #a8a8a3;
  }

  .journey__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding-inline: var(--pad-left) var(--pad-right);
    max-width: var(--sheet);
    margin-inline: auto;
  }

  .journey__head h1 {
    font-size: var(--step-3);
  }

  .journey__how {
    color: var(--j-soft);
    font-size: var(--step-1);
    transition: opacity 400ms var(--ease-out);
  }

  .journey.has-walked .journey__how {
    opacity: 0.4;
  }

  .only-touch {
    display: none;
  }

  @media (hover: none) {
    .only-keys {
      display: none;
    }

    .only-touch {
      display: inline;
    }
  }

  .stage {
    position: relative;
    height: min(70svh, 620px);
    min-height: 360px;
    margin-top: var(--space-3);
    overflow: hidden;
    border-block: 2px solid var(--j-ink);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .world {
    display: block;
    width: 100%;
    height: 100%;
  }

  .j-line {
    fill: none;
    stroke: var(--j-ink);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .j-thin {
    stroke-width: 2;
  }

  .j-thick {
    stroke-width: 6;
  }

  .j-hatch {
    stroke: var(--j-ink);
    stroke-width: 2;
  }

  .j-fill {
    fill: var(--j-paper);
    stroke: var(--j-ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .tree-in {
    stroke: none;
  }

  .j-ink {
    fill: var(--j-ink);
  }

  .j-text {
    fill: var(--j-ink);
    font-family: var(--font-pen);
    font-size: 21px;
    letter-spacing: 0.06em;
  }

  .j-text--rev {
    fill: var(--j-paper);
  }

  .j-text--big {
    font-size: 26px;
  }

  .j-text--small {
    font-size: 15px;
  }

  .ground {
    stroke-width: 4;
  }

  .road {
    stroke-dasharray: 18 22;
    stroke-width: 2;
  }

  .hills {
    stroke-width: 2;
    opacity: 0.35;
  }

  .cloud {
    stroke-width: 2;
    opacity: 0.6;
    animation: drift var(--d) ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      translate: 80px 0;
    }
  }

  .flag {
    transform-box: fill-box;
    transform-origin: left center;
    animation: flag 1.6s ease-in-out infinite alternate;
  }

  @keyframes flag {
    to {
      transform: skewY(-8deg) scaleX(0.9);
    }
  }

  .train {
    animation: train 7s linear infinite;
  }

  @keyframes train {
    to {
      transform: translateX(1100px);
    }
  }

  .steam {
    stroke-width: 2;
    animation: steam 2.4s ease-in-out infinite;
  }

  @keyframes steam {
    0% {
      opacity: 0;
      translate: 0 6px;
    }

    40% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      translate: 0 -14px;
    }
  }

  .spark {
    stroke-width: 2;
    animation: blink 1.2s steps(2) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .note {
    animation: note 2.6s ease-in-out infinite;
  }

  .n2 {
    animation-delay: -1.3s;
  }

  @keyframes note {
    0% {
      opacity: 0;
      translate: 0 10px;
    }

    30% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      translate: 10px -40px;
    }
  }

  .plane {
    animation: fly 9s linear infinite;
  }

  @keyframes fly {
    from {
      transform: translate(-460px, -300px);
    }

    to {
      transform: translate(460px, -330px);
    }
  }

  .plane--short {
    animation: fly-short 6s linear infinite;
  }

  @keyframes fly-short {
    from {
      transform: translate(-280px, -250px);
    }

    to {
      transform: translate(280px, -280px);
    }
  }

  .wave {
    animation: wave 2s ease-in-out infinite alternate;
  }

  @keyframes wave {
    to {
      translate: 12px 0;
    }
  }

  .cap {
    animation: bob 2.4s ease-in-out infinite alternate;
  }

  @keyframes bob {
    to {
      translate: 0 -10px;
    }
  }

  .j-limb {
    stroke: var(--j-ink);
    stroke-width: 15;
    stroke-linecap: round;
  }

  .j-limb--arm {
    stroke-width: 11;
  }

  .j-head {
    stroke-width: 4;
  }

  [data-beard] {
    transform-box: fill-box;
    transform-origin: top center;
    transition: opacity 300ms;
  }

  [data-pack] {
    transition: opacity 400ms;
  }

  /* The card at each stop */
  .jcard {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: min(23rem, calc(100% - 2rem));
    padding: 1rem 1.25rem 1.1rem;
    background: var(--j-paper);
    border: 2px solid var(--j-ink);
    border-radius: 6px;
    box-shadow: 6px 6px 0 var(--j-ink);
    opacity: 0;
    transform: translateY(-10px) rotate(-1deg);
    transition:
      opacity 300ms var(--ease-out),
      transform 400ms var(--ease-out);
    pointer-events: none;
  }

  .jcard.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .jcard__when {
    color: var(--j-soft);
    font-size: var(--step-0);
  }

  .jcard__title {
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .jcard__text {
