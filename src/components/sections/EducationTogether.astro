---
// Education and Build together, short versions for the home page. Each links to its full page.
import Arrow from '../Arrow.astro';
---

<section class="edu" id="education" aria-labelledby="edu-title">
  <div class="sheet">
    <p class="pen exp__kick" data-reveal>03 · education</p>
    <h2 class="exp__title" id="edu-title" data-reveal>Where I learned it.</h2>
    <ol class="line edu__list" data-reveal>
      <li>
        <span class="when">2026 on</span>
        <div>
          <strong>Post Graduate Programme in Technology & Business Management</strong>
          <span class="what">Masters' Union. In progress.</span>
        </div>
      </li>
      <li>
        <span class="when">May 2025</span>
        <div>
          <strong>Databricks Certified Data Engineer Associate</strong>
          <span class="what">Earned May 2025.</span>
        </div>
      </li>
      <li>
        <span class="when">2018 to 2022</span>
        <div>
          <strong>B.Tech, Computer Engineering</strong>
          <span class="what">NMIMS, Mukesh Patel School of Technology Management & Engineering.</span>
        </div>
      </li>
      <li>
        <span class="when">2021 to 2022</span>
        <div>
          <strong>Chairperson, NM Debate Society</strong>
          <span class="what">Organised and led activities for more than 200 debaters.</span>
        </div>
      </li>
    </ol>
    <p class="edu__more" data-reveal>
      <a class="go" href="/education/">Everything else, including volunteering <Arrow /></a>
    </p>
    <p class="back"><a href="#paths">↑ Back to the paths</a></p>
  </div>
</section>

<section class="together" id="together" aria-labelledby="together-title">
  <div class="sheet">
    <p class="pen exp__kick" data-reveal>04 · build together</p>
    <h2 class="exp__title" id="together-title" data-reveal>What I want to build next.</h2>
    <ul class="together__areas" data-reveal>
      <li><span>Healthcare</span></li>
      <li><span>Tech</span></li>
      <li><span>Travel</span></li>
    </ul>
    <p class="exp__intro" data-reveal>
      Those are the three I care about most. If you're working on something else, or just want to brainstorm, write to
      me anyway.
    </p>
    <p class="together__cta" data-reveal>
      <a class="button" href="/future/">Let's build something</a>
    </p>
    <p class="back"><a href="#paths">↑ Back to the paths</a></p>
  </div>
</section>
