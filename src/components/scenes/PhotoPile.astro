---
// Real photographs as one collage, all visible at once, no captions.
// Each photo has a slot (`area`) in the grid; add photos by adding entries and a slot in scenes.css.
import { Image } from 'astro:assets';
import vietnam from '../../assets/images/travel-vietnam.jpg';
import rappel from '../../assets/images/waterfall-rappel.jpg';
import snow from '../../assets/images/snow-summit.jpg';
import bike from '../../assets/images/bike-dusk.jpg';
import sea from '../../assets/images/sea-swim.jpg';
import sheep from '../../assets/images/valley-sheep.jpg';
import pillars from '../../assets/images/forest-pillars.jpg';

const photos = [
  { src: snow, area: 'snow', alt: 'A person in a yellow hooded jacket setting up a tripod on a snowy summit, with an orange horizon and haze over the valley below.' },
  { src: sea, area: 'sea', alt: 'A person floating on their back in clear turquoise water, with sailboats anchored behind and pine-covered islands on the horizon.' },
  { src: vietnam, area: 'vietnam', alt: 'Three travellers sitting on parked scooters on a gravel shore in Vietnam, with green limestone hills and still water behind them.' },
  { src: sheep, area: 'sheep', alt: 'Two sheep, one white and one black, grazing on a green slope above a valley thick with pine trees.' },
  { src: rappel, area: 'rappel', alt: 'Shivam in an orange helmet and a red life vest, leaning back on a rope as he rappels down a waterfall, with forest behind him.' },
  { src: pillars, area: 'pillars', alt: 'A person with a backpack walking a stone path through green forest towards tall sandstone pillars in the mist.' },
  { src: bike, area: 'bike', alt: 'A loaded motorcycle parked at dusk beside a small brick building, with hills and an orange sky behind it.' },
];
---

<div class="collage" data-collage>
  {
    photos.map((p) => (
      <figure class={`collage__item collage__item--${p.area}`} data-photo>
        <Image src={p.src} alt={p.alt} widths={[480, 960]} sizes="(min-width: 60rem) 28vw, 50vw" />
      </figure>
    ))
  }
</div>

<script>
  import { animate, inView, stagger } from 'motion';
  import { reduceMotion } from '../../scripts/motion-utils';

  document.querySelectorAll<HTMLElement>('[data-collage]').forEach((collage) => {
    if (reduceMotion()) return;
    const items = collage.querySelectorAll<HTMLElement>('[data-photo]');
    items.forEach((el) => (el.style.opacity = '0'));
    inView(
      collage,
      () => {
        animate(
          items,
          { opacity: [0, 1], scale: [0.92, 1], clipPath: ['inset(12% 12% 12% 12% round 6px)', 'inset(0% 0% 0% 0% round 6px)'] },
          { duration: 0.9, delay: stagger(0.08), ease: [0.16, 1, 0.3, 1] },
        );
      },
      { amount: 0.1 },
    );
  });
</script>
