---
// A pen-drawn arrow. `long` is the one that crosses a column rule in the flow.
const { long = false, class: className = '' } = Astro.props;
---

{
  long ? (
    <svg class:list={['arrow', className]} viewBox="0 0 36 12" width="36" height="12" aria-hidden="true" focusable="false">
      <path pathLength="1" d="M1.5 6.6c5-1.3 9.8.9 15 .1 5.2-.8 10.6-.6 17-.5m-5.4-4.4c2 1.6 3.8 3 5.6 4.4-2.1 1.2-4 2.6-5.8 4.3" />
    </svg>
  ) : (
    <svg class:list={['arrow', className]} viewBox="0 0 24 12" width="24" height="12" aria-hidden="true" focusable="false">
      <path pathLength="1" d="M1.5 6.4c4.4-.9 8.6.6 12.6.2 2.6-.2 5-.3 7.6-.3m-4.9-4.2c1.8 1.5 3.4 2.8 5.1 4.2-1.9 1.2-3.6 2.5-5.3 4.1" />
    </svg>
  )
}
